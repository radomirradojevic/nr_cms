{
  "version": 2,
  "target": "staging",
  "endpoints": {
    "master": "https://master.staging.example.invalid",
    "vendorCms": "https://vendor-cms.staging.example.invalid",
    "customerCms": "https://customer-cms.staging.example.invalid",
    "vendorWebshop": "https://vendor-shop.staging.example.invalid",
    "customerWebshop": "https://customer-shop.staging.example.invalid",
    "customerLicenseServer": "https://customer-issuer.staging.example.invalid",
    "deploymentWorker": "https://deploy-worker.staging.example.invalid",
    "acceptanceControl": "https://acceptance-control.staging.example.invalid"
  },
  "identity": {
    "kind": "oidc",
    "credentialEnv": "NR_ACCEPTANCE_STAGING_IDENTITY"
  },
  "provider": {
    "kind": "stripe",
    "mode": "sandbox",
    "credentialEnv": "NR_ACCEPTANCE_PROVIDER_IDENTITY",
    "webhookEndpoint": "https://cms.staging.example.invalid/api/webhooks/provider"
  },
  "operator": {
    "kind": "oauth2-bearer",
    "credentialEnv": "NR_ACCEPTANCE_OPERATOR_IDENTITY"
  },
  "scenarioRunner": {
    "commandEnv": "NR_ACCEPTANCE_SCENARIO_RUNNER_PATH",
    "sha256": "3333333333333333333333333333333333333333333333333333333333333333",
    "pollIntervalMs": 2000,
    "timeoutSeconds": 1800
  },
  "releaseCandidate": {
    "sourceMode": "signed-rc-artifacts",
    "artifactSetId": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "previousPackageDigest": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    "packageDigests": {
      "master": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
      "cmsHost": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
      "webshop": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
      "licenseServerAddon": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
      "licenseServerService": "1111111111111111111111111111111111111111111111111111111111111111",
      "deploymentWorker": "2222222222222222222222222222222222222222222222222222222222222222"
    }
  },
  "performanceSlo": {
    "issueP95Ms": 750,
    "validateP95Ms": 250,
    "soakSeconds": 900
  },
  "evidenceDirectoryEnv": "NR_STAGING_EVIDENCE_DIRECTORY"
}
