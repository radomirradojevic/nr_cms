# Standalone Master License Server. This is not the embedded customer add-on.

NODE_ENV=production
DATABASE_URL=postgresql://nrls_runtime:REPLACE@DB_HOST/master_license_server?sslmode=require
NRLS_MIGRATOR_DATABASE_URL=postgresql://nrls_migrator:REPLACE@DB_HOST/master_license_server?sslmode=require
NR_MIGRATION_TARGET=production
NR_MIGRATION_SERVICE=central
NR_MIGRATION_EXPECTED_HOST=DB_HOST
NR_MIGRATION_EXPECTED_DATABASE=master_license_server
NR_MIGRATION_EXPECTED_PROVIDER_RESOURCE_ID=REPLACE_WITH_PROVIDER_RESOURCE_ID
NR_MIGRATION_PROVIDER_RESOURCE_ID=REPLACE_WITH_PROVIDER_RESOURCE_ID

NRLS_ENVIRONMENT=production
NRLS_PUBLIC_URL=https://ls.nrcms.com
# Logical signed issuer stays versioned even though transport is ls.nrcms.com.
NRLS_KEYSET_ISSUER=https://license-server.nrcms.com
NRLS_MANUAL_ISSUER_DOMAIN=vendor.nrcms.com
NRLS_VENDOR_AUDIENCE=https://vendor.nrcms.com
NRLS_OPERATOR_OUTPUT_DIR=/var/lib/nrls/operator-output
NRLS_RATE_LIMIT_STORE=postgres
NRLS_NONCE_CLEANUP_CRON_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTES
# Vercel only: exact same value as NRLS_NONCE_CLEANUP_CRON_SECRET.
CRON_SECRET=REPLACE_WITH_SAME_NONCE_CLEANUP_SECRET
VENDOR_LICENSE_API_V2=true

NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE
TURNSTILE_SECRET_KEY=REPLACE
NRLS_SECRET_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64URL_OR_HEX
NRLS_SECRET_ENCRYPTION_KID=master-envelope-v1
NRLS_SECRET_DECRYPTION_KEYS_JSON={}

NRLS_VENDOR_SIGNING_PRIVATE_KEY=REPLACE_WITH_ED25519_PRIVATE_PEM_MULTILINE
NRLS_VENDOR_SIGNING_KID=REPLACE_WITH_ENTITLEMENT_SIGNING_KID
NRLS_ENTITLEMENT_PUBLIC_KEYSET_FILE=
NRLS_ENTITLEMENT_PUBLIC_KEYSET_BASE64=REPLACE_WITH_CANONICAL_KEYSET_BASE64
NRLS_ENTITLEMENT_PUBLIC_KEYSET_SHA256=REPLACE_WITH_64_HEX_SHA256_OF_EXACT_BYTES

NRLS_PURCHASE_INTENT_SIGNING_PRIVATE_KEY=REPLACE_WITH_ED25519_PRIVATE_PEM_MULTILINE
NRLS_PURCHASE_INTENT_SIGNING_KID=REPLACE_WITH_PURCHASE_INTENT_SIGNING_KID
NRLS_PURCHASE_INTENT_PUBLIC_KEYSET_FILE=
NRLS_PURCHASE_INTENT_PUBLIC_KEYSET_BASE64=REPLACE_WITH_CANONICAL_KEYSET_BASE64
NRLS_PURCHASE_INTENT_PUBLIC_KEYSET_SHA256=REPLACE_WITH_64_HEX_SHA256_OF_EXACT_BYTES

NRLS_ADDON_RELEASE_PUBLIC_KEYS_FILE=
NRLS_ADDON_RELEASE_PUBLIC_KEYS_BASE64=REPLACE_WITH_CANONICAL_RELEASE_KEYSET_BASE64
NRLS_ADDON_RELEASE_PUBLIC_KEYS_SHA256=REPLACE_WITH_64_HEX_SHA256_OF_EXACT_BYTES
NRLS_ADDON_RELEASE_ALLOWED_KIDS=REPLACE_WITH_COMMA_SEPARATED_ACTIVE_RELEASE_KIDS

# Used only by release:* CLI from a protected operator machine, not by HTTP.
NRLS_RELEASE_OPERATOR_DB_ROLE=nrls_release_operator
NRLS_RELEASE_OPERATOR_DATABASE_URL_FILE=/var/lib/nrls/operator-input/release-operator-database-url
NRLS_RELEASE_RUNTIME_ROOT=/var/lib/nrls/releases
