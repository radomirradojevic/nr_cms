# Night Raven CMS Client - both paid add-ons preinstalled, checkout initially off.

NODE_ENV=production
NR_CMS_DEPLOYMENT_PROFILE=client
NR_CMS_EXPECTED_HOSTNAME=client.nrcms.com
NR_CMS_ENV_PHASE=build
NR_CMS_PREINSTALL_POLICY=strict
NR_ADDON_SOURCE_MODE=registry
NR_LICENSE_ENVIRONMENT=production
NR_CMS_VERSION=0.1.0
NR_CMS_RELEASE_SHA=REPLACE_WITH_40_HEX_GIT_COMMIT
NEXT_PUBLIC_APP_URL=https://client.nrcms.com
NR_VERCEL_PROJECT_ID=prj_replace_with_client_project_id

NR_CMS_PREINSTALL_WEBSHOP_VERSION=0.6.44
NR_CMS_PREINSTALL_LICENSE_SERVER_VERSION=0.2.1
NR_GITHUB_PACKAGES_READ_TOKEN=REPLACE_WITH_GITHUB_PACKAGES_READ_TOKEN
NR_ADDON_RELEASE_PUBLIC_KEYS_URL=https://ls.nrcms.com/.well-known/nr-addon-release-keys.json
NR_ADDON_RELEASE_PUBLIC_KEYS_SHA256=REPLACE_WITH_64_HEX_SHA256

DATABASE_URL=postgresql://client_runtime:REPLACE@DB_HOST/client_cms?sslmode=require
NR_CORE_MIGRATOR_DATABASE_URL=postgresql://client_core_migrator:REPLACE@DB_HOST/client_cms?sslmode=require
NR_ADDON_MIGRATOR_DATABASE_URL=postgresql://client_addon_migrator:REPLACE@DB_HOST/client_cms?sslmode=require
DATABASE_POOL_MAX=5
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
NR_MIGRATION_TARGET=production
NR_MIGRATION_SERVICE=cms
NR_MIGRATION_EXPECTED_HOST=DB_HOST
NR_MIGRATION_EXPECTED_DATABASE=client_cms
NR_MIGRATION_EXPECTED_PROVIDER_RESOURCE_ID=REPLACE_WITH_PROVIDER_RESOURCE_ID
NR_MIGRATION_PROVIDER_RESOURCE_ID=REPLACE_WITH_PROVIDER_RESOURCE_ID
NR_MIGRATION_EXPECTED_LIST=
NR_ADDON_MIGRATION_BACKUP_CONFIRMED=true
NR_ADDON_MIGRATION_BACKUP_REFERENCE=REPLACE_WITH_PITR_OR_SNAPSHOT_REFERENCE

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_REPLACE
CLERK_SECRET_KEY=sk_live_REPLACE
CLERK_WEBHOOK_SECRET=whsec_REPLACE
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE
TURNSTILE_SECRET_KEY=REPLACE
IP_HASH_SALT=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CRON_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTES
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_REPLACE
EMAIL_FROM=Client CMS <noreply@client.nrcms.com>

STORAGE_PROVIDER=vercel-blob
# VPS: set STORAGE_PROVIDER=local and UPLOADS_DIR=/app/data/uploads.
# UPLOADS_DIR=/app/data/uploads
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_REPLACE
VERCEL_FLUID_COMPUTE=1
VERCEL_BLOB_MAX_UPLOAD_BYTES=104857600

NR_MASTER_LICENSE_URL=https://ls.nrcms.com
NRLS_ALLOWED_OUTBOUND_HOSTS=ls.nrcms.com,client.nrcms.com
NRLS_ALLOW_SELF_HOSTED_OUTBOUND=true
NR_ALLOW_INSECURE_LOOPBACK_HTTP=false
NR_ADDON_INSTALLATION_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64URL
NR_ADDON_INSTALLATION_ENCRYPTION_KID=client-installation-v1

WEBSHOP_ENABLED=true
WEBSHOP_STOREFRONT_ENABLED=false
WEBSHOP_CHECKOUT_ENABLED=false
WEBSHOP_INSTALL_MODE=preinstalled
WEBSHOP_DEPLOYMENT_MODE=vercel
WEBSHOP_PUBLIC_BASE_URL=https://client.nrcms.com
WEBSHOP_COOKIE_SECURE=true
WEBSHOP_PAYMENTS_MODE=test
WEBSHOP_CART_TOKEN_SALT=REPLACE_WITH_RANDOM_32_PLUS_BYTES
WEBSHOP_DOWNLOAD_TOKEN_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTES
WEBSHOP_DOWNLOAD_EVENT_HASH_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTES
WEBSHOP_LICENSE_SERVER_SECRET_KEY=REPLACE_WITH_DISTINCT_32_BYTE_KEY
WEBSHOP_LICENSE_KEY_ENCRYPTION_KEY=REPLACE_WITH_DISTINCT_32_BYTE_KEY
WEBSHOP_LICENSE_KEY_ENCRYPTION_KID=client-license-pool-v1
WEBSHOP_ISSUED_LICENSE_KEY_ENCRYPTION_KEY=REPLACE_WITH_DISTINCT_32_BYTE_KEY
WEBSHOP_ISSUED_LICENSE_KEY_ENCRYPTION_KID=client-issued-license-v1
WEBSHOP_ISSUED_LICENSE_KEY_DECRYPTION_KEYS_JSON={}
WEBSHOP_PAYMENT_INBOX_ENCRYPTION_KEY=REPLACE_WITH_DISTINCT_32_BYTE_KEY
WEBSHOP_PAYMENT_INBOX_ENCRYPTION_KID=client-payment-inbox-v1
WEBSHOP_PURCHASE_INTENT_SESSION_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTES
WEBSHOP_DELIVERY_WORKER_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTES
WEBSHOP_ENTITLEMENT_REVALIDATION_WORKER_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTES
WEBSHOP_POST_ISSUE_LICENSE_STATUS_MAX_AGE_SECONDS=60
NR_ADDON_TRANSFER_APPROVAL_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTES
NR_ADDON_TRANSFER_APPROVAL_KID=client-transfer-v1
WEBSHOP_BUY_URL=https://vendor.nrcms.com/licenses/purchase-intents/accept
WEBSHOP_BUY_OFFER_KEY=nr-cms-webshop-license
LICENSE_SERVER_BUY_OFFER_KEY=nr-cms-license-server-license
NR_PURCHASE_INTENT_PUBLIC_KEYS_URL=https://ls.nrcms.com/.well-known/nr-purchase-intent-keys.json

LICENSE_SERVER_ENABLED=true
LICENSE_SERVER_INSTALL_MODE=preinstalled
LICENSE_SERVER_DEPLOYMENT_MODE=vercel
LICENSE_SERVER_CUSTOMER_ENVIRONMENT=production
LICENSE_SERVER_ACTIVE_ENCRYPTION_KEY_ID=client-license-server-wrap-v1
LICENSE_SERVER_ENCRYPTION_KEYS_JSON={"client-license-server-wrap-v1":"REPLACE_WITH_32_BYTE_BASE64URL"}
LICENSE_SERVER_SECRET_KEY=
LICENSE_SERVER_LEGACY_SECRET_KEY=
LICENSE_SERVER_RUNTIME_HASH_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTES
LICENSE_SERVER_TRUSTED_PROXY_HOPS=1
LICENSE_SERVER_BUY_URL=https://vendor.nrcms.com/licenses/purchase-intents/accept
LICENSE_SERVER_BUY_LINK_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTES
