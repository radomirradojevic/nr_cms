# Non-secret Docker build pins. Copy to deploy/docker/.env or export these in
# the shell that runs docker compose. Keep the GitHub Packages token out of this
# file; export NR_GITHUB_PACKAGES_READ_TOKEN so BuildKit can mount it as a secret.
NR_CMS_RELEASE_SHA=REPLACE_WITH_40_HEX_GIT_COMMIT
NR_ADDON_RELEASE_PUBLIC_KEYS_SHA256=REPLACE_WITH_64_HEX_SHA256
NR_CMS_PREINSTALL_WEBSHOP_VERSION=0.6.44
NR_CMS_PREINSTALL_LICENSE_SERVER_VERSION=0.2.1
