# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.npm-cache/
/logs
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tmp/

# next.js
/.next/
/out/

# production
/build
/.generated/

# misc
.DS_Store
*.pem
/.tmp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.example.vendor

# vercel
.vercel

# private add-ons and services
.private/

# Internal architecture, operations, and package documentation.
# Keep out of the public nr_cms repository.
#/docs/

# typescript
*.tsbuildinfo
next-env.d.ts

.agents/
# Keep local Copilot prompts/hooks/instructions private, but publish the reviewed
# CI/release gates so GitHub can actually execute what the acceptance tests read.
.github/*
!.github/workflows/
.github/workflows/*
!.github/workflows/ci.yml
!.github/workflows/private-release.yml
!.github/workflows/staging-acceptance.yml
!.github/workflows/production-rollout.yml
AGENTS.md
CLAUDE.md

# uploaded files (file manager)
/storage/
