# ===========================================================================
# UNIVERSAL CLIENT CMS VARIABLES
# Core CMS infrastructure and access to paid Night Raven add-ons.
# ===========================================================================

# Runtime identity is independent from URL/port transport identity.
NR_CMS_DEPLOYMENT_PROFILE=client
NR_LICENSE_ENVIRONMENT=production
NR_ADDON_SOURCE_MODE=registry

# PostgreSQL connection used only by the client CMS runtime. It must never use
# the core owner or migrator role. The local target is nr_cms_client_test with
# login nr_cms_client_runtime; db:core:migrate resolves its credential only
# from the protected DPAPI LocalMachine operator ref.
DATABASE_URL="postgresql://nr_cms_client_runtime:password@127.0.0.1:5432/nr_cms_client_test"

# Required when a paid add-on is enabled; the base CMS does not need it.
# NEXT_PUBLIC_APP_URL=https://your-domain.example

# Public Clerk key used for browser authentication.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Server-only Clerk key; it must never be sent to the browser.
CLERK_SECRET_KEY="sk_test_..."

# Optional: required only when the Clerk webhook is configured.
# CLERK_WEBHOOK_SECRET="whsec_..."

# Public Cloudflare Turnstile site key for forms and comments.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only Cloudflare Turnstile key used to verify tokens.
TURNSTILE_SECRET_KEY=

# Active email transport: resend or smtp.
EMAIL_PROVIDER=resend

# Resend API key when EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# Default From address for transactional email.
EMAIL_FROM="CMS <noreply@your-domain.example>"

# Optional SMTP configuration when EMAIL_PROVIDER=smtp.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=true

# Dedicated salt of at least 32 characters for one-way IP hashing.
IP_HASH_SALT=

# Single shared secret for every CMS cron route and scheduler.
CRON_SECRET=

# Optional self-hosted scheduler settings; Vercel uses vercel.json.
# CONTENT_PUBLISHING_CRON_URL=
# CONTENT_PUBLISHING_SCHEDULER_INTERVAL_SECONDS=60
# CONTENT_PUBLISHING_SCHEDULER_ENABLED=true
# CONTENT_PUBLISHING_SCHEDULER_TIMEOUT_MS=30000

# Default self-hosted storage provider. Use vercel-blob on Vercel.
STORAGE_PROVIDER=local

# Upload directory when STORAGE_PROVIDER=local.
UPLOADS_DIR=./storage/uploads

# Optional Vercel Blob/runtime values.
# BLOB_READ_WRITE_TOKEN=
# VERCEL_FLUID_COMPUTE=1
# VERCEL_BLOB_MAX_UPLOAD_BYTES=104857600

# The master URL defaults to https://ls.nrcms.com. Override only for an
# explicitly approved self-hosted or local add-on development environment.
# NR_MASTER_LICENSE_URL=https://ls.nrcms.com

# Required only when an add-on is enabled; encrypts its installation identity.
# NR_ADDON_INSTALLATION_ENCRYPTION_KEY=

# Required for signed Webshop activation outside local development. This is a
# static pinned CMS release identity, never a URL or mutable Git ref.
# NR_CMS_VERSION=0.1.0
# NR_CMS_RELEASE_SHA=<40_lowercase_hex_commit_sha>
# NR_ADDON_INSTALLATION_ENCRYPTION_KID=<active_protected_keyring_kid>

# Defaults to false. Set true only for loopback HTTP during local development.
# NR_ALLOW_INSECURE_LOOPBACK_HTTP=true

# First-party license hosts are allowed by default. Add an approved extra host
# only for a self-hosted License Server integration.
# NRLS_ALLOWED_OUTBOUND_HOSTS=ls.nrcms.com

# Defaults to false; set true only for an explicitly approved self-hosted
# License Server used by Webshop fulfillment.
# NRLS_ALLOW_SELF_HOSTED_OUTBOUND=true

# ===========================================================================
# OPTIONAL PAID WEBSHOP ADD-ON
# These variables belong to a client CMS that activates the Webshop add-on.
# ===========================================================================

# Omit this entire block for a base CMS: WEBSHOP_ENABLED defaults to false.
# When enabling it, configure every uncommented Webshop value below.
# WEBSHOP_ENABLED=true

# Keep the storefront hidden until the client is ready to launch.
# WEBSHOP_STOREFRONT_ENABLED=false

# Keep new checkout sessions disabled until payment setup is complete.
# WEBSHOP_CHECKOUT_ENABLED=false

# Allows signed package installation through the managed deployment flow.
# WEBSHOP_INSTALL_MODE=managed_redeploy

# Default client deployment identity. Use vercel when deployed on Vercel.
# WEBSHOP_DEPLOYMENT_MODE=self_hosted

# Payment providers must remain in test mode until live verification is complete.
# WEBSHOP_PAYMENTS_MODE=test

# Use true for HTTPS production and false only for local HTTP development.
# WEBSHOP_COOKIE_SECURE=true

# Dedicated salt used to hash Webshop cart tokens.
# WEBSHOP_CART_TOKEN_SALT=

# Signs short-lived digital download tokens.
# WEBSHOP_DOWNLOAD_TOKEN_SECRET=

# Hashes sensitive identifiers in download audit events.
# WEBSHOP_DOWNLOAD_EVENT_HASH_SECRET=

# Encrypts License Server credentials stored by the Webshop.
# WEBSHOP_LICENSE_SERVER_SECRET_KEY=

# Dedicated KEK for issued master license keys. It must be a different 32-byte
# value from WEBSHOP_LICENSE_SERVER_SECRET_KEY. The KID is the active envelope
# KID; old KIDs may be supplied only through the protected JSON keyring.
# WEBSHOP_ISSUED_LICENSE_KEY_ENCRYPTION_KEY=
# WEBSHOP_ISSUED_LICENSE_KEY_ENCRYPTION_KID=webshop-issued-license-kek-v1
# WEBSHOP_ISSUED_LICENSE_KEY_DECRYPTION_KEYS_JSON={}

# A separate post-issue worker credential; CRON_SECRET is never accepted by
# /api/cron/webshop-post-issue-delivery. Validation observations must be 15..300 seconds.
# WEBSHOP_DELIVERY_WORKER_SECRET=
# WEBSHOP_POST_ISSUE_LICENSE_STATUS_MAX_AGE_SECONDS=60
# WEBSHOP_ENTITLEMENT_REVALIDATION_WORKER_SECRET=
# NR_ADDON_TRANSFER_APPROVAL_SECRET=
# NR_ADDON_TRANSFER_APPROVAL_KID=

# "fixture" is deterministic and suitable only for local/integration tests.
# A production adapter is provisioned separately and is verified in Prompt 18.
# WEBSHOP_DELIVERY_EMAIL_PROVIDER=fixture

# Trusted purchase-intent handoff endpoint; it must be HTTPS and exact.
# WEBSHOP_BUY_URL=https://vendor.example/licenses/purchase-intents/accept

# Stable master offer key. The browser never supplies this authority.
# WEBSHOP_BUY_OFFER_KEY=nr-cms-webshop-license

# Required by the vendor runtime only. The JWS never controls this URL.
# NR_PURCHASE_INTENT_PUBLIC_KEYS_URL=https://ls.nrcms.com/.well-known/nr-purchase-intent-keys.json
# WEBSHOP_PURCHASE_INTENT_SESSION_SECRET=

# Optional client-managed Webshop redeploy callback; configure all three.
# WEBSHOP_REDEPLOY_WEBHOOK_URL=
# WEBSHOP_REDEPLOY_AUTH_KID=
# WEBSHOP_REDEPLOY_AUTH_SECRET=

# Prompt 07 outbox transport only. These values authenticate CMS -> deployment
# worker; they do not grant registry access and the worker itself is Prompt 08.
# NR_ADDON_DEPLOYMENT_WORKER_URL=https://deploy.nr.test
# NR_ADDON_DEPLOYMENT_WORKER_AUTH_KID=
# NR_ADDON_DEPLOYMENT_WORKER_AUTH_SECRET=

# Worker -> CMS callback key. This is per target, is different from the
# redeploy request key above, and is retained by KID during outbox retries.
# WEBSHOP_DEPLOYMENT_RESULT_AUTH_KID=
# WEBSHOP_DEPLOYMENT_RESULT_AUTH_SECRET=
# WEBSHOP_DEPLOYMENT_RESULT_AUTH_OLD_SECRETS_JSON={}

# Optional public origin for externally hosted payment checkout/return URLs.
# WEBSHOP_PUBLIC_BASE_URL=

# Optional Stripe configuration.
# WEBSHOP_STRIPE_SECRET_KEY=
# WEBSHOP_STRIPE_WEBHOOK_SECRET=

# Optional PayPal configuration.
# WEBSHOP_PAYPAL_CLIENT_ID=
# WEBSHOP_PAYPAL_CLIENT_SECRET=
# WEBSHOP_PAYPAL_WEBHOOK_ID=
# WEBSHOP_PAYPAL_API_BASE_URL=

# Optional Paddle configuration.
# WEBSHOP_PADDLE_API_KEY=
# WEBSHOP_PADDLE_CLIENT_TOKEN=
# WEBSHOP_PADDLE_WEBHOOK_SECRET=
# WEBSHOP_PADDLE_API_BASE_URL=

# Optional bank-redirect payment callback secret.
# WEBSHOP_BANK_REDIRECT_WEBHOOK_SECRET=

# ===========================================================================
# OPTIONAL PAID LICENSE-SERVER ADD-ON
# Customer-owned embedded issuer; this is not the ls.nrcms.com master server.
# ===========================================================================

# Omit this entire block for a base CMS: LICENSE_SERVER_ENABLED defaults to
# false. This customer-owned embedded issuer is separate from ls.nrcms.com.
# LICENSE_SERVER_ENABLED=true

# Allows signed package installation through the managed deployment flow.
# LICENSE_SERVER_INSTALL_MODE=managed_redeploy

# Default client deployment identity. Use vercel when deployed on Vercel.
# LICENSE_SERVER_DEPLOYMENT_MODE=self_hosted

# Scope environment for licenses issued by the client-owned License Server.
# LICENSE_SERVER_CUSTOMER_ENVIRONMENT=production

# Encrypts API client shared secrets for the License Server add-on.
# LICENSE_SERVER_SECRET_KEY=

# Public Night Raven page used to purchase a License Server add-on license.
# LICENSE_SERVER_BUY_URL=https://www.nrcms.com/license-server

# Signs the time-limited domain payload in the License Server purchase link.
# LICENSE_SERVER_BUY_LINK_SECRET=

# Optional client-managed License Server redeploy callback; configure all three.
# LICENSE_SERVER_REDEPLOY_WEBHOOK_URL=
# LICENSE_SERVER_REDEPLOY_AUTH_KID=
# LICENSE_SERVER_REDEPLOY_AUTH_SECRET=

# Optional migration policy. Production migrations run as an explicit step.
# DRIZZLE_AUTO_MIGRATE=0
