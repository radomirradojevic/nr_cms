# ===========================================================================
# COMMON CORE VARIABLES - CLIENT AND VENDOR CMS
# Shared CMS infrastructure and paid add-on activation.
# ===========================================================================

# Runtime identity is independent from URL/port transport identity.
NR_CMS_DEPLOYMENT_PROFILE=vendor
NR_LICENSE_ENVIRONMENT=production
NR_ADDON_SOURCE_MODE=registry

# PostgreSQL connection used only by the vendor CMS runtime. It must never use
# the core owner or migrator role. The local target is nr_cms_vendor_test with
# login nr_cms_vendor_runtime; db:core:migrate resolves its credential only
# from the protected DPAPI LocalMachine operator ref.
DATABASE_URL="postgresql://nr_cms_vendor_runtime:password@127.0.0.1:5432/nr_cms_vendor_test"

# Public canonical origin of the nrcms.com vendor CMS.
NEXT_PUBLIC_APP_URL=https://nrcms.com

# Public Clerk key used for browser authentication.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."

# Server-only Clerk key; it must never be sent to the browser.
CLERK_SECRET_KEY="sk_live_..."

# Optional: required only when the Clerk webhook is configured.
# CLERK_WEBHOOK_SECRET="whsec_..."

# Public Cloudflare Turnstile site key for forms and comments.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-only Cloudflare Turnstile key used to verify tokens.
TURNSTILE_SECRET_KEY=

# Active email transport: resend or smtp.
EMAIL_PROVIDER=resend

# Resend API key when EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# Default From address for transactional email.
EMAIL_FROM="Night Raven CMS <noreply@nrcms.com>"

# Optional SMTP configuration when EMAIL_PROVIDER=smtp.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=true

# Dedicated salt of at least 32 characters for one-way IP hashing.
IP_HASH_SALT=

# Single shared secret for every CMS cron route and scheduler.
CRON_SECRET=

# Optional self-hosted scheduler settings; Vercel uses vercel.json.
# CONTENT_PUBLISHING_CRON_URL=
# CONTENT_PUBLISHING_SCHEDULER_INTERVAL_SECONDS=60
# CONTENT_PUBLISHING_SCHEDULER_ENABLED=true
# CONTENT_PUBLISHING_SCHEDULER_TIMEOUT_MS=30000

# The nrcms.com production deployment on Vercel uses Vercel Blob.
STORAGE_PROVIDER=vercel-blob

# Used only when STORAGE_PROVIDER=local; it has no effect on Vercel.
UPLOADS_DIR=./storage/uploads

# Optional Vercel Blob/runtime values.
# BLOB_READ_WRITE_TOKEN=
# VERCEL_FLUID_COMPUTE=1
# VERCEL_BLOB_MAX_UPLOAD_BYTES=104857600

# Single master endpoint for paid add-on activation and revalidation.
NR_MASTER_LICENSE_URL=https://ls.nrcms.com

# Encrypts the private add-on identity key for this CMS installation.
NR_ADDON_INSTALLATION_ENCRYPTION_KEY=

# Set true only for loopback HTTP during local development.
NR_ALLOW_INSECURE_LOOPBACK_HTTP=false

# License endpoints that client and vendor CMS installations may contact.
NRLS_ALLOWED_OUTBOUND_HOSTS=ls.nrcms.com

# Additional self-hosted License Server destinations are denied by default.
NRLS_ALLOW_SELF_HOSTED_OUTBOUND=false

# ===========================================================================
# COMMON WEBSHOP ADD-ON VARIABLES - CLIENT AND VENDOR CMS
# Shared Webshop contract; the configured values belong to nrcms.com.
# ===========================================================================

# Enables the Webshop add-on and its routes.
WEBSHOP_ENABLED=true

# Exposes the public Webshop storefront.
WEBSHOP_STOREFRONT_ENABLED=true

# Allows the Webshop to create checkout sessions.
WEBSHOP_CHECKOUT_ENABLED=true

# Webshop package installation policy.
WEBSHOP_INSTALL_MODE=managed_redeploy

# Production deployment identity of this Webshop.
WEBSHOP_DEPLOYMENT_MODE=vercel

# Keep test until every configured payment provider passes live verification.
WEBSHOP_PAYMENTS_MODE=test

# HTTPS production requires a Secure cart cookie.
WEBSHOP_COOKIE_SECURE=true

# Dedicated salt used to hash Webshop cart tokens.
WEBSHOP_CART_TOKEN_SALT=

# Signs short-lived digital download tokens.
WEBSHOP_DOWNLOAD_TOKEN_SECRET=

# Hashes sensitive identifiers in download audit events.
WEBSHOP_DOWNLOAD_EVENT_HASH_SECRET=

# Encrypts License Server credentials stored by the Webshop.
WEBSHOP_LICENSE_SERVER_SECRET_KEY=

# Trusted purchase-intent handoff endpoint. It must be HTTPS and exact.
WEBSHOP_BUY_URL=https://nrcms.com/licenses/purchase-intents/accept

# Stable master offer key. The browser never supplies this authority.
WEBSHOP_BUY_OFFER_KEY=nr-cms-webshop-license

# Hashes the opaque vendor purchase-intent session cookie.
WEBSHOP_PURCHASE_INTENT_SESSION_SECRET=

# Exact master public-key discovery URL for compact purchase-intent JWS
# verification. It is trusted deployment configuration, never read from JWS.
NR_PURCHASE_INTENT_PUBLIC_KEYS_URL=https://ls.nrcms.com/.well-known/nr-purchase-intent-keys.json

# Optional managed Webshop redeploy callback; configure all three.
# WEBSHOP_REDEPLOY_WEBHOOK_URL=
# WEBSHOP_REDEPLOY_AUTH_KID=
# WEBSHOP_REDEPLOY_AUTH_SECRET=

# Prompt 08 CMS -> deployment worker transport. The URL is the HTTPS worker
# origin; the target route is selected only from this CMS deployment profile.
# NR_ADDON_DEPLOYMENT_WORKER_URL=https://deploy.nr.test
# NR_ADDON_DEPLOYMENT_WORKER_AUTH_KID=
# NR_ADDON_DEPLOYMENT_WORKER_AUTH_SECRET=

# Deployment worker -> this CMS result callback. It must use a different
# per-target secret/KID from the CMS -> worker request credential.
# WEBSHOP_DEPLOYMENT_RESULT_AUTH_KID=
# WEBSHOP_DEPLOYMENT_RESULT_AUTH_SECRET=
# WEBSHOP_DEPLOYMENT_RESULT_AUTH_OLD_SECRETS_JSON={}

# Optional public origin for externally hosted payment checkout/return URLs.
# WEBSHOP_PUBLIC_BASE_URL=

# Optional Stripe configuration.
# WEBSHOP_STRIPE_SECRET_KEY=
# WEBSHOP_STRIPE_WEBHOOK_SECRET=

# Optional PayPal configuration.
# WEBSHOP_PAYPAL_CLIENT_ID=
# WEBSHOP_PAYPAL_CLIENT_SECRET=
# WEBSHOP_PAYPAL_WEBHOOK_ID=
# WEBSHOP_PAYPAL_API_BASE_URL=

# Optional Paddle configuration.
# WEBSHOP_PADDLE_API_KEY=
# WEBSHOP_PADDLE_CLIENT_TOKEN=
# WEBSHOP_PADDLE_WEBHOOK_SECRET=
# WEBSHOP_PADDLE_API_BASE_URL=

# ===========================================================================
# COMMON LICENSE-SERVER ADD-ON VARIABLES - CLIENT AND VENDOR CMS
# Shared customer-owned issuer contract; this is not the ls.nrcms.com master.
# ===========================================================================

# The nrcms.com vendor value is false because it uses the separate master server.
LICENSE_SERVER_ENABLED=false

# Enable managed_redeploy only when this embedded add-on is activated.
LICENSE_SERVER_INSTALL_MODE=disabled

# Deployment identity used if the embedded add-on is activated on Vercel.
LICENSE_SERVER_DEPLOYMENT_MODE=vercel

# Scope environment for licenses issued by the customer-owned License Server.
LICENSE_SERVER_CUSTOMER_ENVIRONMENT=production

# Encrypts API client shared secrets for the embedded License Server add-on.
LICENSE_SERVER_SECRET_KEY=

# Public page used to purchase a License Server add-on license.
LICENSE_SERVER_BUY_URL=https://www.nrcms.com/license-server

# Signs the time-limited domain payload in the License Server purchase link.
LICENSE_SERVER_BUY_LINK_SECRET=

# Optional managed License Server redeploy; configure all three.
# LICENSE_SERVER_REDEPLOY_WEBHOOK_URL=
# LICENSE_SERVER_REDEPLOY_AUTH_KID=
# LICENSE_SERVER_REDEPLOY_AUTH_SECRET=

# Optional migration policy. Production migrations run as an explicit step.
# DRIZZLE_AUTO_MIGRATE=0

# ===========================================================================
# NRCMS.COM VENDOR CMS ONLY
# Internal rollout and payment callback settings not required by client CMS.
# ===========================================================================

# Internal vendor rollout switch for the new payment-state reducer.
WEBSHOP_PAYMENT_STATE_V2=false

# Internal vendor rollout switch for the license-fulfillment outbox.
WEBSHOP_LICENSE_OUTBOX_V2=false

# Internal vendor rollout switch for the V2 master license API.
VENDOR_LICENSE_API_V2=false

# Verifies the nrcms.com bank-redirect payment callback signatures.
WEBSHOP_BANK_REDIRECT_WEBHOOK_SECRET=
